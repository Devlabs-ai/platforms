{
  "contentSource": "minio",
  "dualInput": true,
  "eventsInputPath": "s3a://devlabs-data/datasets/novamart/events/1m/",
  "catalogInputPath": "s3a://devlabs-data/datasets/novamart/dims/catalog_scd/",
  "runEventsInputPath": "s3a://devlabs-data/datasets/novamart/events/20k/",
  "runCatalogInputPath": "s3a://devlabs-data/datasets/novamart/dims/catalog_current/",
  "evalSolutionPath": "s3a://devlabs-data/challenges/l3-broadcast-catalog-enrichment/expected/",
  "outputFormat": "parquet",
  "gradeKeys": [
    "event_id"
  ],
  "language": "python",
  "starterFileName": "src/main.py",
  "limits": {
    "driver": 1,
    "driverMemory": "512m",
    "executors": 2,
    "executorCores": 1,
    "executorMemory": "1g"
  },
  "gradeChecks": [
    "Spark job succeeds on the shared 1M events + versioned catalog",
    "OUTPUT_PATH is Parquet with one row per matched event",
    "Current catalog row only (latest effective_ts, tie-break product_name); brand and list_price attached; payload is not in the output"
  ]
}
