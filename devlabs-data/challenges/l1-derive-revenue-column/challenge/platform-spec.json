{
  "contentSource": "minio",
  "testcasesPrefix": "s3a://devlabs-data/challenges/l1-derive-revenue-column/testcases/",
  "runCases": [
    "01-run-edges"
  ],
  "submitCases": [
    "02-submit-all"
  ],
  "inputPath": "s3a://devlabs-data/challenges/l1-derive-revenue-column/testcases/",
  "evalSolutionPath": "s3a://devlabs-data/challenges/l1-derive-revenue-column/testcases/",
  "outputFormat": "parquet",
  "gradeKeys": [
    "txn_id"
  ],
  "gradeScript": "s3a://devlabs-data/challenges/l1-derive-revenue-column/grade/grade.py",
  "language": "python",
  "starterFileName": "src/main.py",
  "limits": {
    "driver": 1,
    "driverMemory": "1g",
    "executors": 2,
    "executorCores": 1,
    "executorMemory": "1g",
    "aqe": false
  },
  "sparkConf": {
    "spark.sql.adaptive.enabled": "false"
  },
  "scoring": {
    "executionTime": {
      "targetSeconds": 45,
      "bands": [
        { "maxSeconds": 15, "label": "quick", "tone": "quick" },
        { "maxSeconds": 45, "label": "steady", "tone": "steady" },
        { "label": "slow", "tone": "slow" }
      ]
    }
  },
  "gradeChecks": [
    "Functional: candidate Parquet matches expected on txn_id (POS only, trimmed id, one row per ticket)",
    "Performance: shuffle from dropDuplicates is visible; pace is labeled from History and does not fail the lab"
  ]
}
